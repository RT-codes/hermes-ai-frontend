# Server-side Vite proxy settings. Copy to .env.local and keep real credentials private.
HERMES_API_TARGET=http://127.0.0.1:8642
HERMES_API_KEY=replace-with-your-hermes-api-key

# Profile discovery uses the Hermes dashboard management API. These credentials
# stay on the Vite server and are never sent to browser code directly.
HERMES_DASHBOARD_TARGET=http://127.0.0.1:9119
HERMES_DASHBOARD_USERNAME=replace-with-dashboard-username
HERMES_DASHBOARD_PASSWORD=replace-with-dashboard-password

HINDSIGHT_API_TARGET=http://127.0.0.1:8889
